# Modo de ejecución ('development' | 'production' | 'test')
NODE_ENV=development
PORT=3000
SERVER_HOST=127.0.0.1
TRUST_PROXY=false

# Conexión a Base de Datos (MariaDB / MySQL)
DATABASE_URL="mysql://cuadra:cuadra1234@localhost:3306/10_proyecto_calidad_db"

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Parámetros de Sesión
SESSION_DURATION_DAYS=3650
ACCESS_TOKEN_EXPIRES_MINUTES=15
SESSION_COOKIE_NAME=auth_session
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Rate Limiting (15 minutos / 10000 solicitudes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# Secreto criptográfico para firma de Access Tokens (min 32 caracteres)
JWT_SECRET=change_me_to_a_secure_random_string_32_characters_minimum

# Credenciales de inicio para bootstrap / seed
SUPER_ADMIN_USUARIO=admin
SUPER_ADMIN_NOMBRE="Super Administrador"
SUPER_ADMIN_PASSWORD=change_this_password_on_production